# Public local-development settings. Supply production secrets at runtime.
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_DEBUG=1
PORT=8001
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://[::1]:8001
DJANGO_APPEND_SLASH=True
DJANGO_SITE_ID=1
# from docker compose.yaml
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/postgres

DJANGO_ADMIN_USERNAME=admin
# Supply DJANGO_ADMIN_PASSWORD or DJANGO_ADMIN_PASSWORD_FILE to enable auto_admin.
DJANGO_ADMIN_EMAIL=notset@notset.com
