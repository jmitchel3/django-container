{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./Dockerfile",
    "watchPatterns": [
      ".dockerignore",
      "Dockerfile",
      "Dockerfile.mysql",
      "Dockerfile.node",
      "gunicorn.conf.py",
      "requirements.txt",
      "requirements.mysql.txt",
      "scripts/**",
      "src/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz/",
    "healthcheckTimeout": 300,
    "startupTimeout": 300,
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 10
  }
}
